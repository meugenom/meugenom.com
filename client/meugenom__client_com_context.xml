/* Based on GitHub's theme but with customizations */

.utterances {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  max-width: 760px;
  margin-left: auto;
  margin-right: auto;
  margin-bottom: 2em;
}

.utterances-frame {
  position: absolute;
  left: 0;
  right: 0;
  width: 1px;
  min-width: 100%;
  max-width: 100%;
  height: 100%;
  border: 0;
}

/* Light theme (default) */
.utterances-frame {
  color-scheme: light;
  /*
  color: #24292e;
  background-color: #fff;
  */
}

/* Custom button styles */
.btn {
  padding: 5px 16px;
  font-size: 14px;
  font-weight: 500;
  line-height: 20px;
  border: 1px solid;
  border-radius: 6px;
  cursor: pointer;
  transition: 0.2s cubic-bezier(0.3, 0, 0.5, 1);
}
</file>

<file path="src/styles/base/errors.css">
/* css for errors pages */
.error-container{
    display: flex;
    width: 100vw;
    height: 75vh;
    align-items: center;
    justify-content: center;    
    margin: 0;
    color: white;
    font-size: 10rem;
    font-family: monospace;
    letter-spacing: -7px;

  }
  
  .error{
    text-transform: uppercase;
    font-size: 10rem;
    text-align: center;
    display: -webkit-flex;
    display: flex;
    -webkit-align-items: center;
    align-items: center;
    -webkit-justify-content: center;
    justify-content: center;
    margin: 0;
    /* background: white; */
    position: relative;
  }
  
  .error:before{
    content: attr(data-text);
    position: absolute;
    background: linear-gradient(#475569, #a2b3cb, #38bdf8);
    -webkit-background-clip: text;
    color: transparent;
    background-size: 100% 90%;
    line-height: 0.9;
    clip-path: ellipse(120px 120px at -2.54% -9.25%);
    animation: error_spin 5s infinite;
    animation-direction: alternate;
  }
  
  @keyframes error_spin{
    0%{
       -webkit-clip-path: ellipse(120px 120px at -2.54% -9.25%);
       clip-path: ellipse(120px 120px at -2.54% -9.25%)
    }
    50%{
      -webkit-clip-path: ellipse(120px 120px at 49.66% 64.36%);
      clip-path: ellipse(120px 120px at 49.66% 64.36%);
  
    }
    100%{
       -webkit-clip-path: ellipse(120px 120px at 102.62% -1.61%);
      clip-path: ellipse(120px 120px at 102.62% -1.61%);
    }
}
</file>

<file path="src/styles/base/loader.css">
/* css for elements Loader */
.loader_container {                        
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 40vh;
}
.loader {
    border: 2px solid #f3f3f3;
    border-top: 2px solid #42A5F5;
    border-radius: 50%;
    width: 40px;
    height: 40px;
    animation: spin 2s linear infinite;
}


/* css for elements ImageLoader */
.imageLoader {
    border: 4px solid #f3f3f3; /* Light grey */
    border-top: 4px solid #9fa1a3; /* Blue */
    border-radius: 50%;
    width: 30px;
    height: 30px;
    animation: spin 2s linear infinite;
    margin: 20px auto; /* Adjust the margin as needed */
}

/* Add animation to page and image loaders */

@keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}
</file>

