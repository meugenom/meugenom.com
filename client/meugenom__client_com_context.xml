/* css for active navigation links */
.active-links {
    position: relative;
    text-decoration: none;
    display: inline-block;
    opacity: 1.0;
}

.active-links::after {
    content: "";
    position: absolute;
    width: 100%;
    height: 2px; 
    background-color: #42A5F5;

    bottom: -2px;
    left: 0;
  }

  /* title animation */

  title{
    text-transform: uppercase;
    font-size: 1.5rem;
    text-align: center;
    display: -webkit-flex;
    display: flex;
    -webkit-align-items: center;
    align-items: center;
    -webkit-justify-content: center;
    justify-content: center;
    margin: 0;
