    (Router as any).instance = null; // Reset singleton

    // Set up the real JSDOM body
    document.body.innerHTML = `
      <header id="header"></header>
      <main id="content"></main>
      <footer id="footer"></footer>
      <div id="side-bar-right"></div>
      <div id="side-bar-left"></div>
      <div id="page"></div>
    `;

    // Cache real DOM elements
    headerEl = document.getElementById("header")!;
    contentEl = document.getElementById("content")!;
    footerEl = document.getElementById("footer")!;
    sidebarRightEl = document.getElementById("side-bar-right")!;
    sidebarLeftEl = document.getElementById("side-bar-left")!;
    pageEl = document.getElementById("page")!;

    // Mock Window API
    mockPushState = jest
      .spyOn(window.history, "pushState")
      .mockImplementation(() => {});
    mockDispatchEvent = jest
      .spyOn(window, "dispatchEvent")
      .mockImplementation(() => true);
    mockAddEventListener = jest
      .spyOn(window, "addEventListener")
      .mockImplementation(() => {});
    mockParseRequestURL = (
      Utils.prototype.parseRequestURL as jest.Mock
    ).mockReturnValue({ resource: null, id: null, verb: null });

    // Mock Components
    (Navbar as unknown as jest.Mock).mockImplementation(() => ({
      render: jest.fn().mockResolvedValue("<nav>Nav</nav>"),
      afterRender: jest.fn(),
    }));
    (Layout as unknown as jest.Mock).mockImplementation(() => ({
      getHTMLElement: jest
        .fn()
        .mockResolvedValue(document.createElement("div")),
      afterRender: jest.fn(),
    }));
    (SideBarRight as unknown as jest.Mock).mockImplementation(() => ({
      render: jest
        .fn()
        .mockResolvedValue('<div id="side-bar-right-content">SideBar</div>'),
    }));
    (Footer as unknown as jest.Mock).mockImplementation(() => ({
      render: jest
        .fn()
        .mockResolvedValue('<footer id="footer-content">Footer</footer>'),
      afterRender: jest.fn(),
    }));
    (Error404 as unknown as jest.Mock).mockImplementation(() => ({
      render: jest.fn().mockResolvedValue('<div id="error404">404</div>'),
      afterRender: jest.fn(),
    }));
    (Error502 as unknown as jest.Mock).mockImplementation(() => ({
      render: jest.fn().mockResolvedValue('<div id="error502">502</div>'),
      afterRender: jest.fn(),
    }));

    routes = mockRoutes;
    router = new Router(routes);
    await router.init();
  });

  describe("Constructor & Initialization", () => {
    it("should instantiate all required components and bind event listeners", () => {
      expect(Navbar).toHaveBeenCalledTimes(1);
      expect(Layout).toHaveBeenCalledTimes(1);
      expect(SideBarRight).toHaveBeenCalledTimes(1);
      expect(Footer).toHaveBeenCalledTimes(1);
      expect(window.addEventListener).toHaveBeenCalledWith(
        "popstate",
        expect.any(Function),
      );
    });

    it("should call init() which renders header, layout, content, and attaches listeners", async () => {
      expect(headerEl.innerHTML).not.toBe("");
      expect(sidebarRightEl.innerHTML).toContain("SideBar");
    });
  });

  describe("Routing & Rendering", () => {
    it("should render matched route and call afterRender", async () => {
      mockParseRequestURL.mockReturnValue({
        resource: null,
        id: null,
        verb: null,
      });
      await router.renderContent();

      expect(mockRoutes["/"].render).toHaveBeenCalled();
      expect(mockRoutes["/"].afterRender).toHaveBeenCalled();
    });

    it("should fallback to Error404 for unknown routes", async () => {
      mockParseRequestURL.mockReturnValue({
        resource: "unknown",
        id: null,
        verb: null,
      });
      await router.renderContent();

      expect(Error404).toHaveBeenCalledTimes(1);
    });

    it("should fallback to Error502 when route.render() throws", async () => {
      const errorRoute = {
        render: jest.fn().mockRejectedValue(new Error("Network")),
        afterRender: jest.fn(),
      };
      routes["/test"] = errorRoute;
      mockParseRequestURL.mockReturnValue({
        resource: "test",
        id: null,
        verb: null,
      });

      await router.renderContent();

      expect(Error502).toHaveBeenCalledTimes(1);
    });
  });

  describe("URL Parsing", () => {
    it("should correctly parse simple routes", () => {
      mockParseRequestURL.mockReturnValue({
        resource: "article",
        id: "my-post",
        verb: "edit",
      });
      const parsed = (router as any).parseUrl();
      expect(parsed).toBe("/article/:id/edit");
    });

    it("should handle root and partial routes", () => {
      mockParseRequestURL.mockReturnValue({
        resource: null,
        id: null,
        verb: null,
      });
      expect((router as any).parseUrl()).toBe("/");

      mockParseRequestURL.mockReturnValue({
        resource: "tags",
        id: "js",
        verb: null,
      });
      expect((router as any).parseUrl()).toBe("/tags/:id");
    });
  });

  describe("Navigation & History API", () => {
    it("should handle link clicks: prevent default, pushState, and re-render", async () => {
      const mockEvent = {
        preventDefault: jest.fn(),
        target: { closest: () => ({ getAttribute: () => "/about" }) },
      };

      mockParseRequestURL.mockReturnValue({
        resource: null,
        id: null,
        verb: null,
      });
      await router.handleLinkClick(mockEvent as any);

      expect(mockEvent.preventDefault).toHaveBeenCalled();
      expect(mockPushState).toHaveBeenCalledWith(
        {},
        "",
        expect.stringContaining("/about"),
      );
    });
  });

  describe("Popstate Listener", () => {
  
    it("should trigger re-render when popstate fires and path changes", async () => {
      const popstateCallback = mockAddEventListener.mock.calls[0][1] as (
        e: PopStateEvent,
      ) => void;

      mockParseRequestURL.mockReturnValue({
        resource: "new",
        id: null,
        verb: null,
      });
      window.location.pathname = "/new";

      popstateCallback(new PopStateEvent("popstate"));

      await new Promise((r) => setTimeout(r, 0));
      
      // Check if the route matching logic was triggered      
      expect(mockParseRequestURL).toHaveBeenCalled();      
    });
  });
});
